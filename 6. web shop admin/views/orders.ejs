<!DOCTYPE html>
<html lang="en">
<%- include('./shared/head.ejs') %>

    <body>
        <%- include('./shared/header.ejs') %>
            <main>
                <section class="colored-section">
                    <div class="container">
                        <table class="app-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Full name</th>
                                    <th>Status</th>
                                    <th>Payment type</th>
                                    <th>Order</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% orders.forEach(element=> { %>
                                    <tr>
                                        <td>
                                            <%= element.id %>
                                        </td>
                                        <td>
                                            <%= element.fullName %>
                                        </td>
                                        <td>
                                            <%= element.status %>
                                        </td>
                                        <td>
                                            <%= element.paymentType %>
                                        </td>
                                        <td>
                                            <%= element.orderDate %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                </section>


            </main>
            <%- include('./shared/footer.ejs') %>
    </body>

</html>