<!DOCTYPE html>
<html lang="en">
  <% locals.pageStyles.push("/styles/pages/order-details.css") %> <%-
  include('./shared/head.ejs') %>
  <body>
    <%- include('./shared/header.ejs') %>
    <main>
      <section>
        <div class="container">
          <h2>Shipping Info</h2>
          <p>Full name: <%= locals.orderDetails.fullName %></p>
          <p>Street: <%= locals.orderDetails.street %></p>
          <p>City: <%= locals.orderDetails.city %></p>
          <p>Phone Number: <%= locals.orderDetails.phoneNumber %></p>
          <p>Zip Code: <%= locals.orderDetails.zipCode %></p>
          <p>Payment type: <%= locals.orderDetails.paymentType %></p>
          <p>Status: <%= locals.orderDetails.status %></p>
          <p>Order Date: <%= locals.orderDetails.orderDate %></p>
        </div>
      </section>
      <section>
        <div class="container">
          <table class="app-table">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Name</th>
                                    <th>price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                              <% for( let index = 0; index < locals.orderDetails.orderItems.length; index++ ) {
                                const orderItem = locals.orderDetails.orderItems[index] %>
                                <tr>
                                  <td><%= orderItem.id %></td>
                                  <td><%= orderItem.name %></td>
                                  <td><%= orderItem.price %></td>
                                  <td><%= orderItem.quantity %></td>
                                  <td><%= orderItem.total %>€</td>
                                </tr>
                              <% } %>
                            </tbody>
                        </table>
                        <p>Total amount: <%= locals.orderDetails.orderTotalAmount %> €</p>
        </div>
      </section>
    </main>
    <%- include('./shared/footer.ejs') %>
  </body>
</html>
